generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReviewStatus {
  new
  analysis_pending
  draft_ready
  regeneration_pending
  publishing
  published
  manual_handled
  deferred
  failed
}

enum ReviewSeverity {
  green
  yellow
  red
}

enum ReviewPriority {
  low
  medium
  high
  urgent
}

enum ApiClientEnvironment {
  test
  live
}

enum ApiOperationStatus {
  queued
  running
  succeeded
  failed
  canceled
}

enum ApiIdempotencyStatus {
  processing
  completed
  failed
}

enum WebhookDeliveryStatus {
  pending
  delivering
  delivered
  failed
}

model OwnerUser {
  id           String   @id @default(cuid())
  email        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SecretValue {
  id         String   @id @default(cuid())
  scope      String
  key        String
  ciphertext String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  googleRefreshAccounts GoogleAccount[] @relation("GoogleRefreshToken")
  twilioConfigs         TwilioConfig[]  @relation("TwilioAuthToken")

  @@unique([scope, key])
}

model GoogleAccount {
  id                   String    @id @default(cuid())
  googleUserId         String    @unique
  email                String
  refreshTokenSecretId String
  accessTokenEncrypted String?
  tokenExpiresAt       DateTime?
  status               String    @default("active")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  refreshTokenSecret SecretValue        @relation("GoogleRefreshToken", fields: [refreshTokenSecretId], references: [id])
  businessLocations  BusinessLocation[]
}

model BusinessLocation {
  id                      String   @id @default(cuid())
  googleAccountId         String
  googleLocationName      String
  googleAccountName       String?
  placeId                 String?
  businessName            String
  address                 String?
  googleOpenStatus        String?
  notificationPhoneNumber String?
  enabled                 Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  googleAccount GoogleAccount @relation(fields: [googleAccountId], references: [id], onDelete: Cascade)
  reviews       Review[]
  apiClientLocations ApiClientLocation[]

  @@unique([googleAccountId, googleLocationName])
  @@index([enabled])
  @@index([googleOpenStatus])
}

model Review {
  id                    String       @id @default(cuid())
  businessLocationId    String
  googleReviewId        String
  authorName            String?
  rating                Int
  reviewText            String?
  reviewCreatedAt       DateTime?
  status                ReviewStatus @default(new)
  latestDraftId         String?
  publishedReply        String?
  replyPublishedAt      DateTime?
  notifyAt              DateTime?
  notified              Boolean      @default(false)
  notificationSentAt    DateTime?
  notificationStatus    String       @default("none")
  notificationAttempts  Int          @default(0)
  notificationLastError String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  businessLocation BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Cascade)
  analysis         ReviewAnalysis?
  drafts           ReplyDraft[]
  actions          ReviewAction[]
  jobs             JobRun[]

  @@unique([businessLocationId, googleReviewId])
  @@index([status])
  @@index([notifyAt, notified])
  @@index([notificationStatus, notifyAt])
}

model ReviewAnalysis {
  id          String         @id @default(cuid())
  reviewId    String         @unique
  severity    ReviewSeverity
  priority    ReviewPriority
  issues      String[]
  positives   String[]
  keywords    String[]
  publishRisk Json
  reasoning   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ReplyDraft {
  id          String    @id @default(cuid())
  reviewId    String
  aiBody      String
  body        String
  instruction String?
  version     Int
  userEdited  Boolean   @default(false)
  editedAt    DateTime?
  createdAt   DateTime  @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, version])
}

model ReviewAction {
  id        String   @id @default(cuid())
  reviewId  String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
}

model JobRun {
  id                  String    @id @default(cuid())
  reviewId            String?
  type                String
  status              String
  provider            String?
  model               String?
  promptVersion       String?
  outputSchemaVersion String?
  transcript          String?
  errorCode           String?
  errorMessage        String?
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  review Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([type, status])
  @@index([reviewId])
}

model TwilioConfig {
  id                String   @id @default("singleton")
  accountSid        String
  authTokenSecretId String
  fromNumber        String
  notifyToNumber    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  authTokenSecret SecretValue @relation("TwilioAuthToken", fields: [authTokenSecretId], references: [id])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
}

model ApiClient {
  id           String               @id @default(cuid())
  name         String
  environment  ApiClientEnvironment
  scopes       String[]
  allLocations Boolean              @default(false)
  revokedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  credentials       ApiCredential[]
  locationGrants    ApiClientLocation[]
  operations        ApiOperation[]
  idempotencyRecords ApiIdempotencyRecord[]
  auditEvents       ApiAuditEvent[]
  webhookEndpoints  WebhookEndpoint[]

  @@index([environment, revokedAt])
}

model ApiCredential {
  id           String    @id @default(cuid())
  apiClientId  String
  keyPrefix    String    @unique
  secretHash   String
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  apiClient   ApiClient       @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  operations  ApiOperation[]
  auditEvents ApiAuditEvent[]

  @@index([apiClientId, revokedAt])
}

model ApiClientLocation {
  apiClientId String
  locationId  String
  createdAt   DateTime @default(now())

  apiClient ApiClient        @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  location  BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([apiClientId, locationId])
  @@index([locationId])
}

model ApiOperation {
  id              String             @id @default(cuid())
  apiClientId     String
  apiCredentialId String
  requestId       String
  type            String
  status          ApiOperationStatus @default(queued)
  resourceType    String?
  resourceId      String?
  locationId      String?
  queueJobId      String?
  jobRunId        String?
  result          Json?
  error           Json?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  apiClient     ApiClient     @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  apiCredential ApiCredential @relation(fields: [apiCredentialId], references: [id], onDelete: Restrict)
  idempotencyRecord ApiIdempotencyRecord?

  @@index([apiClientId, createdAt])
  @@index([jobRunId])
  @@index([queueJobId])
  @@index([status, createdAt])
}

model ApiIdempotencyRecord {
  id                 String               @id @default(cuid())
  apiClientId        String
  operationId        String               @unique
  action             String
  idempotencyKey     String
  requestFingerprint String
  status             ApiIdempotencyStatus @default(processing)
  responseStatus     Int?
  responseBody       Json?
  expiresAt          DateTime
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  apiClient ApiClient    @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  operation ApiOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([apiClientId, action, idempotencyKey])
  @@index([expiresAt])
}

model ApiAuditEvent {
  id              String   @id @default(cuid())
  apiClientId     String?
  apiCredentialId String?
  requestId       String
  action          String
  targetType      String?
  targetId        String?
  result          String
  httpStatus      Int?
  sourceIp        String?
  userAgent       String?
  durationMs      Int?
  metadata        Json?
  createdAt       DateTime @default(now())

  apiClient     ApiClient?     @relation(fields: [apiClientId], references: [id], onDelete: SetNull)
  apiCredential ApiCredential? @relation(fields: [apiCredentialId], references: [id], onDelete: SetNull)

  @@index([apiClientId, createdAt])
  @@index([requestId])
  @@index([createdAt])
}

model WebhookEndpoint {
  id              String   @id @default(cuid())
  apiClientId     String
  url             String
  events          String[]
  secretEncrypted String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  apiClient  ApiClient         @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([apiClientId, active])
}

model WebhookDelivery {
  id          String                @id @default(cuid())
  endpointId  String
  eventId     String
  eventType   String
  payload     Json
  status      WebhookDeliveryStatus @default(pending)
  attempts    Int                   @default(0)
  nextAttemptAt DateTime?
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
}
